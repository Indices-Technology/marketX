###############################################################################
# MarketX — Environment Configuration (template)
#
# Copy to `.env` and fill in. Grouped by concern; mirrors the live .env layout.
# Required vars are validated on startup in server/config/env.ts.
###############################################################################


# ═══════════════════════════════════════════════════════════════════════════
# CORE / ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════
NODE_ENV=development


# ═══════════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL — Prisma)
# ═══════════════════════════════════════════════════════════════════════════
# For `prisma migrate deploy`, use the DIRECT (non-pooler) URL.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"


# ═══════════════════════════════════════════════════════════════════════════
# AUTH / JWT
# ═══════════════════════════════════════════════════════════════════════════
# Must be ≥32 chars and DIFFERENT from each other in production.
# Generate: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_base64
JWT_REFRESH_SECRET=your_jwt_refresh_secret_base64


# ═══════════════════════════════════════════════════════════════════════════
# PAYMENTS
# ═══════════════════════════════════════════════════════════════════════════
# Paystack — use sk_live_ / pk_live_ in production
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Platform commission — single source of truth (charged at payout/POD settlement)
PLATFORM_FEE_PERCENT=3
# Flat transfer fee per payout, in kobo (5000 = ₦50)
PAYSTACK_TRANSFER_FEE_KOBO=5000


# ═══════════════════════════════════════════════════════════════════════════
# MEDIA — Cloudinary
# ═══════════════════════════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=ml_default


# ═══════════════════════════════════════════════════════════════════════════
# EMAIL — Resend
# ═══════════════════════════════════════════════════════════════════════════
RESEND_API_KEY=re_...
SENDER_EMAIL=notifications@yourdomain.com
# Reply-to for support ticket emails (defaults to support@marketx.africa)
SUPPORT_EMAIL=support@yourdomain.com


# ═══════════════════════════════════════════════════════════════════════════
# AI PROVIDERS
# ═══════════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=
GROK_API_KEY=
# AES key for encrypting per-user AI keys at rest. MUST be exactly 32 chars.
AI_CONFIG_ENCRYPTION_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# REAL-TIME — Soketi (Pusher-compatible WebSockets)
# ═══════════════════════════════════════════════════════════════════════════
# Local dev: docker run -p 6001:6001 quay.io/soketi/soketi (host 127.0.0.1, port 6001, TLS false)
SOKETI_APP_ID=
SOKETI_KEY=
SOKETI_SECRET=
SOKETI_HOST=
SOKETI_PORT=443
SOKETI_USE_TLS=true


# ═══════════════════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════════════════
# Upstash (REST) — caching, rate limiting, idempotency. Cache disabled if unset.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Standard Redis (TCP) for BullMQ — NOT Upstash. Jobs run inline if unset.
QUEUE_REDIS_URL=redis://default:password@host:port


# ═══════════════════════════════════════════════════════════════════════════
# SHIPPING
# ═══════════════════════════════════════════════════════════════════════════
# ── Sendbox (Nigeria domestic) ──
SENDBOX_ACCESS_TOKEN=
SENDBOX_CLIENT_SECRET=
SENDBOX_WEBHOOK_SECRET=
# ── Shippo (international) — shippo_live_ in production ──
SHIPPO_API_KEY=shippo_live_...
SHIPPO_WEBHOOK_SECRET=
# ── GIG (Nigeria courier) ──
GIG_BASE_URL=https://dev-thirdpartynode.theagilitysystems.com
GIG_EMAIL=
GIG_PASSWORD=
GIG_CUSTOMER_CODE=
GIG_CUSTOMER_TYPE=0    # 0 = company, 1 = individual
# COD requires GIG's Class plan (~₦4,500/mo)
GIG_COD_ENABLED=false
# ── Platform pricing (all carriers; seller BYOS "self" not marked up) ──
# 0.25 = buyer pays carrier cost x 1.25 (kept as margin)
SHIPPING_MARKUP_PCT=0.25
# Flat handling fee in NGN per shipment. 0 = none.
SHIPPING_HANDLING_FEE=0
# Signs shipping-quote tokens. Falls back to JWT_SECRET when blank.
SHIPPING_QUOTE_SECRET=
# Reserved — POD freight tax (%). Not yet wired.
# POD_FREIGHT_TAX_PCT=0


# ═══════════════════════════════════════════════════════════════════════════
# OAUTH — Social login (MarketX as consumer)
# ═══════════════════════════════════════════════════════════════════════════
# Each provider's console must list: https://<host>/api/auth/oauth/<provider>/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_TIKTOK_CLIENT_KEY=
OAUTH_TIKTOK_CLIENT_SECRET=
# Extra OAuth-allowed origins (comma-separated, host only). BASE_URL host always allowed.
OAUTH_ALLOWED_HOSTS=


# ═══════════════════════════════════════════════════════════════════════════
# OAUTH — MarketX as provider (Dassah AI SSO)
# ═══════════════════════════════════════════════════════════════════════════
OAUTH_DASSAH_CLIENT_ID=dassah
OAUTH_DASSAH_CLIENT_SECRET=dassah_secret_change_in_production
OAUTH_DASSAH_REDIRECT_URIS=http://localhost:3001/api/auth/sso/callback,https://dassah.yourdomain.com/api/auth/sso/callback


# ═══════════════════════════════════════════════════════════════════════════
# DASSAH INTEGRATION
# ═══════════════════════════════════════════════════════════════════════════
# Shared secret for Dassah → MarketX internal API calls. Generate: openssl rand -hex 32
DASSAH_INTERNAL_KEY=
# MARKETX_API_KEY=    # optional legacy header key (x-dassah-internal)


# ═══════════════════════════════════════════════════════════════════════════
# MEDIA DISCOVERY
# ═══════════════════════════════════════════════════════════════════════════
JAMENDO_CLIENT_ID=


# ═══════════════════════════════════════════════════════════════════════════
# PUBLIC / RUNTIME (branding — client-exposed)
# ═══════════════════════════════════════════════════════════════════════════
NUXT_PUBLIC_BASE_URL=https://yourdomain.com
NUXT_PUBLIC_SITE_NAME=MarketX
NUXT_PUBLIC_BRAND_DOMAIN=yourdomain.com
NUXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# NUXT_PUBLIC_PRIVACY_EMAIL=privacy@yourdomain.com
# NUXT_PUBLIC_LEGAL_EMAIL=legal@yourdomain.com
NUXT_PUBLIC_DASSA_SOCKET_URL=


# ═══════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════
# NUXT_PUBLIC_POD_ENABLED=false       # Pay on Delivery surface
# NUXT_PUBLIC_TRUST_PREVIEW=false     # Trust homepage (on in dev automatically)


# ═══════════════════════════════════════════════════════════════════════════
# SECURITY & RATE LIMITING (windows in ms)
# ═══════════════════════════════════════════════════════════════════════════
REQUIRE_EMAIL_VERIFICATION=true
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=3600000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900000
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=3600000
RATE_LIMIT_VERIFY_EMAIL_SEND_MAX=5
RATE_LIMIT_VERIFY_EMAIL_SEND_WINDOW=900000
RATE_LIMIT_VERIFY_EMAIL_TOKEN_MAX=5
RATE_LIMIT_VERIFY_EMAIL_TOKEN_WINDOW=900000
RATE_LIMIT_REFRESH_TOKEN_MAX=10
RATE_LIMIT_REFRESH_TOKEN_WINDOW=300000


# ═══════════════════════════════════════════════════════════════════════════
# LOGGING & MONITORING (all optional)
# ═══════════════════════════════════════════════════════════════════════════
LOG_SERVICE_URL=
LOG_SERVICE_TOKEN=
# EXTERNAL_LOG_SERVICE=
# ENABLE_MONITORING=false
# MONITORING_INTERVAL_MINUTES=5
# SLACK_WEBHOOK_URL=
# DATADOG_API_KEY=
# PAGERDUTY_INTEGRATION_KEY=
# DB_METRICS=false
# DB_METRICS_WARN=500


# ═══════════════════════════════════════════════════════════════════════════
# API DOCS
# ═══════════════════════════════════════════════════════════════════════════
# Gates /_openapi.json, /_scalar, /_swagger behind ?key=<secret>. Blank = open.
OPENAPI_DOCS_SECRET=
